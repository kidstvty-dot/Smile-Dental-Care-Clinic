rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_\\-]+$') && id.size() <= 64;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['patientName', 'phone', 'service', 'status', 'createdAt'])
        && data.patientName is string && data.patientName.size() >= 2 && data.patientName.size() <= 100
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30
        && data.service is string && data.service.size() <= 100
        && data.status in ['pending', 'confirmed', 'completed', 'cancelled']
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'phone', 'message', 'createdAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30
        && data.message is string && data.message.size() <= 1000
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    // Health check test connection document
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId);
      allow list: if true;
      allow create: if isValidId(appointmentId) && isValidAppointment(request.resource.data);
      allow update: if isValidId(appointmentId) && isValidAppointment(request.resource.data);
      allow delete: if isValidId(appointmentId);
    }

    // Contact Inquiries collection
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId);
      allow list: if true;
      allow create: if isValidId(inquiryId) && isValidInquiry(request.resource.data);
      allow update: if false;
      allow delete: if isValidId(inquiryId);
    }

    // Admin metadata (single master admin registration slot)
    match /admin_meta/{docId} {
      allow read, write: if true;
    }
  }
}
